{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/signals",
      "destination": "/models.html",
      "permanent": true
    },
    {
      "source": "/signals.html",
      "destination": "/models.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?path=:path*"
    }
  ],
  "functions": {
    "api/handler.ts": {
      "maxDuration": 30
    }
  }
}
