# Public application origin used to validate SIWE messages and browser origins.
APP_URL=http://localhost:5173
PORT=3000
NODE_ENV=development

# Use at least 32 random characters. Never expose this value to the browser.
SESSION_SECRET=
SESSION_TTL_HOURS=12
DATABASE_PATH=./data/astravaquant.db
DATABASE_URL=

# Public Reown/WalletConnect project identifier. Returned by /api/config.
WALLETCONNECT_PROJECT_ID=

# Server-only GoldRush API key used for read-only indexed portfolio data.
GOLDRUSH_API_KEY=
PORTFOLIO_CACHE_SECONDS=60

# Optional server-only CoinGecko demo key. The terminal can use the keyless
# public endpoint at lower rate limits. Market responses are cached server-side.
COINGECKO_API_KEY=
MARKET_CACHE_SECONDS=300

# Optional server-side RPC endpoints used for SIWE smart-account verification.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
